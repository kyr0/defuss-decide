# Optional development settings; copy to .env (gitignored). The Makefile exports every key to its recipes.
# Chromium binary for the parity scripts (scripts/browser-*.mjs); empty: Playwright's own Chromium.
CHROMIUM_EXECUTABLE_PATH=
# "real" runs the e2e examples against the exported bundles in models/ and compares their printed output.
E2E_MODELS=
# Port of `make demo` and scripts/serve.mjs.
PORT=8080
